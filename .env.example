# Supabase — Project Settings > API
# Copia este fichero a .env.local y rellena los valores. Nunca commitees .env.local.
#
# Las dos son publicas (llegan al navegador): la seguridad la da RLS, no la clave.
# La service_role NO se usa en este proyecto y no debe añadirse aquí.
#
# En Vercel hay que darlas de alta en Settings > Environment Variables ANTES del
# primer despliegue: el build falla a proposito si falta alguna.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional. URL canonica para los metadatos de compartir. Si falta se usa la de
# produccion; en local no hace falta tocarla.
NEXT_PUBLIC_SITE_URL=
